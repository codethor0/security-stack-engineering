{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DetectionRule",
  "type": "object",
  "required": ["rule_id", "name", "technique_ids", "severity"],
  "properties": {
    "rule_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "technique_ids": { "type": "array", "items": { "type": "string" } },
    "tactic_ids": { "type": "array" },
    "data_sources": { "type": "array" },
    "query": { "type": "string" },
    "severity": { "type": "string" },
    "owner": { "type": "string" },
    "enabled": { "type": "boolean" }
  }
}
