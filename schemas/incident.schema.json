{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident",
  "type": "object",
  "required": ["id", "title", "severity", "status", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "severity": { "type": "string" },
    "status": { "type": "string" },
    "phase": { "type": "string" },
    "created_at": { "type": "integer" },
    "updated_at": { "type": "integer" },
    "alert_ids": { "type": "array" },
    "entities": { "type": "array" },
    "actions": { "type": "array" },
    "sla_deadline": { "type": "integer" },
    "engagement_link": { "type": "string" }
  }
}
