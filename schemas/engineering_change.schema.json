{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineeringChange",
  "type": "object",
  "required": ["change_id", "finding_source", "change_type", "priority", "status"],
  "properties": {
    "change_id": { "type": "string" },
    "finding_source": { "type": "string" },
    "finding_ids": { "type": "array" },
    "change_type": { "type": "string" },
    "priority": { "type": "string" },
    "description": { "type": "string" },
    "affected_assets": { "type": "array" },
    "implementation_plan": { "type": "object" },
    "owner": { "type": "string" },
    "due_date": { "type": "string" },
    "status": { "type": "string" },
    "evidence_refs": { "type": "array" }
  }
}
